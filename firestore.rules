rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/Users/$(uid); }
    function couplePath(id) { return /databases/$(database)/documents/Couples/$(id); }
    function invitePath(code) { return /databases/$(database)/documents/Pair_Codes/$(code); }
    function validText(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }
    function validDate(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function isMember(id) {
      return signedIn() && id is string && exists(couplePath(id)) &&
        (get(couplePath(id)).data.uid_1 == request.auth.uid ||
         get(couplePath(id)).data.uid_2 == request.auth.uid);
    }

    match /Users/{uid} {
      // Nunca se permiten listados de perfiles ni consultas por email/código.
      allow get: if signedIn() && (request.auth.uid == uid ||
        (resource.data.id_relacion is string && isMember(resource.data.id_relacion)));
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['uid','nombre','email','codigo_pareja_id','id_relacion']) &&
        request.resource.data.keys().hasAll(['uid','nombre','email','codigo_pareja_id','id_relacion']) &&
        request.resource.data.uid == uid &&
        validText(request.resource.data.nombre,2,70) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.id_relacion == null &&
        request.resource.data.codigo_pareja_id.matches('^AM-([A-F0-9]{4}-){4}[A-F0-9]{4}$') &&
        getAfter(invitePath(request.resource.data.codigo_pareja_id)).data.uid_owner == uid;
      // Solo se puede establecer por primera vez id_relacion. Se exige una
      // pareja creada atómicamente con el código secreto correcto.
      allow update: if signedIn() && resource.data.id_relacion == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id_relacion']) &&
        request.resource.data.id_relacion is string &&
        request.resource.data.id_relacion.size() > 5 &&
        (
          (request.auth.uid == uid &&
            getAfter(couplePath(request.resource.data.id_relacion)).data.uid_1 == uid) ||
          (request.auth.uid != uid &&
            getAfter(couplePath(request.resource.data.id_relacion)).data.uid_1 == request.auth.uid &&
            getAfter(couplePath(request.resource.data.id_relacion)).data.uid_2 == uid &&
            getAfter(couplePath(request.resource.data.id_relacion)).data.codigo_invitacion == resource.data.codigo_pareja_id)
        );
      allow delete: if false;
    }

    // Índice opaco, de acceso por identificador exacto. ¡NO permitir listados!
    match /Pair_Codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid_owner','nombre_publico']) &&
        request.resource.data.keys().hasAll(['uid_owner','nombre_publico']) &&
        request.resource.data.uid_owner == request.auth.uid &&
        validText(request.resource.data.nombre_publico,2,70) &&
        getAfter(userPath(request.auth.uid)).data.codigo_pareja_id == code &&
        getAfter(userPath(request.auth.uid)).data.nombre == request.resource.data.nombre_publico;
      allow update, delete: if false;
    }

    match /Couples/{id} {
      allow get: if signedIn() &&
        (resource.data.uid_1 == request.auth.uid || resource.data.uid_2 == request.auth.uid);
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['id_relacion','uid_1','uid_2','codigo_invitacion','fecha_conocidos','fecha_aniversario']) &&
        request.resource.data.keys().hasAll(['id_relacion','uid_1','uid_2','codigo_invitacion','fecha_conocidos','fecha_aniversario']) &&
        request.resource.data.id_relacion == id &&
        request.resource.data.uid_1 == request.auth.uid &&
        request.resource.data.uid_2 is string &&
        request.resource.data.uid_2 != request.auth.uid &&
        request.resource.data.uid_2.size() > 5 &&
        request.resource.data.codigo_invitacion.matches('^AM-([A-F0-9]{4}-){4}[A-F0-9]{4}$') &&
        validDate(request.resource.data.fecha_conocidos) &&
        validDate(request.resource.data.fecha_aniversario) &&
        get(invitePath(request.resource.data.codigo_invitacion)).data.uid_owner == request.resource.data.uid_2 &&
        get(userPath(request.resource.data.uid_1)).data.id_relacion == null &&
        get(userPath(request.resource.data.uid_2)).data.id_relacion == null &&
        get(userPath(request.resource.data.uid_2)).data.codigo_pareja_id == request.resource.data.codigo_invitacion &&
        getAfter(userPath(request.resource.data.uid_1)).data.id_relacion == id &&
        getAfter(userPath(request.resource.data.uid_2)).data.id_relacion == id;
      allow update: if signedIn() &&
        (resource.data.uid_1 == request.auth.uid || resource.data.uid_2 == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fecha_conocidos','fecha_aniversario']) &&
        validDate(request.resource.data.fecha_conocidos) && validDate(request.resource.data.fecha_aniversario) &&
        (request.resource.data.fecha_conocidos == '' || request.resource.data.fecha_aniversario == '' ||
         request.resource.data.fecha_aniversario >= request.resource.data.fecha_conocidos);
      allow delete: if false;
    }

    match /Private_Notes/{id} {
      // Propiedad PRIVADA estricta, incluso frente a la pareja.
      allow get, list: if signedIn() && resource.data.uid_creador == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['id_nota','uid_creador','contenido','fecha']) &&
        request.resource.data.keys().hasAll(['id_nota','uid_creador','contenido','fecha']) &&
        request.resource.data.id_nota == id &&
        request.resource.data.uid_creador == request.auth.uid &&
        validText(request.resource.data.contenido,3,3000) && validText(request.resource.data.fecha,10,35);
      allow delete: if signedIn() && resource.data.uid_creador == request.auth.uid;
      allow update: if false;
    }

    match /Shared_Goals/{id} {
      allow get, list: if isMember(resource.data.id_relacion);
      allow create: if signedIn() && isMember(request.resource.data.id_relacion) &&
        request.resource.data.keys().hasOnly(['id_meta','id_relacion','uid_creador','tipo','descripcion']) &&
        request.resource.data.keys().hasAll(['id_meta','id_relacion','uid_creador','tipo','descripcion']) &&
        request.resource.data.id_meta == id && request.resource.data.uid_creador == request.auth.uid &&
        request.resource.data.tipo in ['limite','meta'] &&
        validText(request.resource.data.descripcion,5,900);
      allow delete: if signedIn() && isMember(resource.data.id_relacion) &&
        resource.data.uid_creador == request.auth.uid;
      allow update: if false;
    }

    match /Timeline_Conflicts/{id} {
      allow get, list: if isMember(resource.data.id_relacion);
      allow create: if signedIn() && isMember(request.resource.data.id_relacion) &&
        request.resource.data.keys().hasOnly(['id_conflicto','id_relacion','uid_creador','problema','acuerdo','enseñanza','fecha']) &&
        request.resource.data.keys().hasAll(['id_conflicto','id_relacion','uid_creador','problema','acuerdo','enseñanza','fecha']) &&
        request.resource.data.id_conflicto == id && request.resource.data.uid_creador == request.auth.uid &&
        validText(request.resource.data.problema,8,1000) &&
        validText(request.resource.data.acuerdo,8,1000) &&
        validText(request.resource.data.enseñanza,8,1000) && validDate(request.resource.data.fecha) &&
        request.resource.data.fecha != '';
      allow delete: if signedIn() && isMember(resource.data.id_relacion) &&
        resource.data.uid_creador == request.auth.uid;
      allow update: if false;
    }
  }
}
